# Shared configuration for the .NET and Python applications.
# Copy this file to .env in the repository root and fill in your values.
OPENAI_API_KEY=
RAG_PDF_DIR='C:\path\to\pdfs'
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
RAG_COLLECTION_NAME=CollectionWithData
EMBEDDING_MODEL=text-embedding-3-large
CHAT_MODEL=gpt-4o-mini

# Python chunking and chat options.
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_MMR_LAMBDA=0.5
RAG_SCORE_THRESHOLD=0.25
RAG_MAX_CONTEXT_TOKENS=2000
RAG_MAX_ANSWER_TOKENS=400
RAG_DOC_FILTER=
RAG_STREAM=false
